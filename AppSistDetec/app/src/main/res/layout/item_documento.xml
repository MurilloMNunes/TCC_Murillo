<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:color/white"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="16dp">

<!--    <ImageButton-->
<!--        android:id="@+id/buttonRemoveCard"-->
<!--        android:layout_width="40dp"-->
<!--        android:layout_height="40dp"-->
<!--        android:layout_gravity="right"-->
<!--        android:background="?attr/selectableItemBackgroundBorderless"-->
<!--        android:src="@android:drawable/ic_menu_close_clear_cancel"-->
<!--        android:contentDescription="Remover item" />-->

    <TextView
        android:id="@+id/nomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/placaTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Placa do Veículo:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/alertaTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alerta:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dataTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/horarioTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horário:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/latitudeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horário:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/longitudeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horário:"
        android:textSize="18sp" />

    <Button
        android:id="@+id/buttonMaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="16dp"
        android:backgroundTint="#001BB1"
        android:text="Mostrar local no Google Maps" />

</LinearLayout>
